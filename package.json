    "@tailwindcss/vite": "^4.1.14",
    "@turf/turf": "^7.4.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "framer-motion": "^13.1.0",
    "gsap": "^3.15.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.546.0",
