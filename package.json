    "test:fleet": "tsx src/tests/runFleetTestsCli.ts",
    "test:market": "tsx src/tests/runMarketTestsCli.ts",
    "seed:investment-prototype": "tsx scripts/seed-investment-prototype.ts",
    "seed:resources-prototype": "tsx scripts/seed-resources-prototype.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
