rules_version = '2';

// Firebase Storage Security Rules for Oromia Agricultural Bureau Platform
// Milestone 2.1: Deny arbitrary public uploads until full CMS media uploads are enabled in Milestone 2.2.
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny all read/write operations
    match /{allPaths=**} {
      allow read, write: if false;
    }

    /* PROPOSED FUTURE CMS MEDIA PATHS (Milestone 2.2+):
    
    1. News Article Images:
       match /news/{articleId}/{fileName} {
         allow read: if true;
         allow write: if request.auth != null
           && request.resource.size < 5 * 1024 * 1024
           && request.resource.contentType.matches('image/(jpeg|png|webp)');
       }

    2. Achievement Case Media:
       match /achievements/{achievementId}/{fileName} {
         allow read: if true;
         allow write: if request.auth != null
           && request.resource.size < 10 * 1024 * 1024
           && request.resource.contentType.matches('image/(jpeg|png|webp)');
       }

    3. Extension Publications & Manuals:
       match /publications/{fileName} {
         allow read: if true;
         allow write: if request.auth != null
           && request.resource.size < 25 * 1024 * 1024
           && request.resource.contentType.matches('application/(pdf|vnd.openxmlformats-officedocument.wordprocessingml.document)');
       }
    */
  }
}
