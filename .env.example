# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Chatbot Configuration
#
# The assistant runs entirely server-side (src/server/chat/) so GEMINI_API_KEY is
# never exposed to the browser. It answers strictly from Bureau content retrieved
# out of Firestore and src/data/mockData.ts, and declines rather than guessing.
#
# CHAT_COMPOSER: 'gemini' (default when GEMINI_API_KEY is set) or 'template'.
#   'template' produces deterministic, zero-cost answers from the same retrieved
#   records. Retrieval is identical either way, so switching is just this value.
#   Templates are also the automatic fallback when Gemini is missing or failing.
CHAT_COMPOSER=

# Optional overrides (defaults shown):
# CHAT_GEMINI_MODEL=gemini-3.5-flash-lite
# CHAT_TIMEOUT_MS=20000
# CHAT_MAX_MESSAGE_LENGTH=500
# CHAT_RATE_LIMIT_PER_HOUR=20

# Firebase Configuration
#
# Firebase Console > Project settings > General > Your apps > SDK setup and
# configuration > Config. Copy each value across.
#
# These are NOT secrets — Firebase web config ships inside the JavaScript of every
# Firebase site. Access is decided by firestore.rules, not by holding these values.
#
# Used by BOTH the website (to display news, alerts, achievements) and the chatbot
# (to retrieve the same published content). The chatbot needs no service-account
# key: it only reads published documents, which firestore.rules already grants to
# anonymous readers.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mapbox Configuration
#
# VITE_MAPBOX_TOKEN: public access token from https://account.mapbox.com/access-tokens/
# Enables the third map engine (terrain, 3D tilt, hover highlighting) in the
# Interactive Agricultural Map. Without it that engine is disabled and the map
# falls back to OpenLayers — nothing else breaks.
#
# This is a PUBLIC (pk.*) token and ships in the browser bundle by design. Restrict
# it by URL in the Mapbox dashboard. Never put a secret (sk.*) token here.
VITE_MAPBOX_TOKEN=
