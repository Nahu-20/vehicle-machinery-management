rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function currentStaffExists() {
      return isSignedIn()
        && request.auth.uid != null
        && exists(/databases/$(database)/documents/staffUsers/$(request.auth.uid));
    }

    function isStaffUser(uid) {
      return isSignedIn()
        && uid != null
        && exists(/databases/$(database)/documents/staffUsers/$(uid))
        && get(/databases/$(database)/documents/staffUsers/$(uid)).data != null
        && ('active' in get(/databases/$(database)/documents/staffUsers/$(uid)).data)
        && get(/databases/$(database)/documents/staffUsers/$(uid)).data.active == true;
    }

    function isCurrentActiveStaff() {
      return isStaffUser(request.auth.uid);
    }

    function getStaffRole() {
      return currentStaffExists()
        && get(/databases/$(database)/documents/staffUsers/$(request.auth.uid)).data != null
        && ('role' in get(/databases/$(database)/documents/staffUsers/$(request.auth.uid)).data)
        ? get(/databases/$(database)/documents/staffUsers/$(request.auth.uid)).data.role
        : '';
    }

    function isSuperAdmin() {
      return isCurrentActiveStaff() && getStaffRole() == 'superAdmin';
    }

    function isContentAdmin() {
      return isCurrentActiveStaff() && (getStaffRole() == 'superAdmin' || getStaffRole() == 'contentAdmin');
    }

    function isEditor() {
      return isCurrentActiveStaff() && (
        getStaffRole() == 'superAdmin' ||
        getStaffRole() == 'contentAdmin' ||
        getStaffRole() == 'editor'
      );
    }

    function isMarketOfficer() {
      return isCurrentActiveStaff() && (getStaffRole() == 'superAdmin' || getStaffRole() == 'marketOfficer');
    }

    function isAdvisoryOfficer() {
      return isCurrentActiveStaff() && (getStaffRole() == 'superAdmin' || getStaffRole() == 'advisoryOfficer');
    }

    function isFleetOfficer() {
      return isCurrentActiveStaff() && (getStaffRole() == 'superAdmin' || getStaffRole() == 'fleetOfficer');
    }

    function hasAuditViewPermission() {
      return isCurrentActiveStaff() && (getStaffRole() == 'superAdmin' || getStaffRole() == 'contentAdmin');
    }

    /**
     * Who may read the audit trail in order to WRITE to it.
     *
     * logAuditEvent wraps its write in a transaction and reads the target
     * document first, for idempotency. That read is subject to the read rule, so
     * a role that may not read the trail cannot append to it either — and the
     * failure is caught and warned rather than surfaced, which is how a whole
     * module ends up with a silently empty audit history.
     *
     * Reading the trail is still narrower: see hasAuditViewPermission.
     */
    function canAppendAuditLog() {
      return isCurrentActiveStaff();
    }

    function isValidFeaturedImageStaging(docData) {
      return !('featuredImageStaging' in docData) || docData.featuredImageStaging == null || (
        docData.featuredImageStaging is map
        && docData.featuredImageStaging.mediaId is string
        && docData.featuredImageStaging.mediaId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && docData.featuredImageStaging.ownerUid is string
        && docData.featuredImageStaging.ownerUid == request.auth.uid
        && docData.featuredImageStaging.storagePath is string
        && docData.featuredImageStaging.storagePath.matches('^media/staging/' + request.auth.uid + '/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && docData.featuredImageStaging.status == 'staged'
        && !('downloadUrl' in docData.featuredImageStaging)
        && !('publicUrl' in docData.featuredImageStaging)
      );
    }

    // Collection: staffUsers
    match /staffUsers/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow update: if isSuperAdmin() || (
        isCurrentActiveStaff()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
      );
      allow delete: if isSuperAdmin();
    }

    // Collection: newsArticles (CMS News Articles)
    match /newsArticles/{newsSlug} {
      // Public can read only published articles where publishedAt <= request.time; active staff can read any status
      allow get: if isCurrentActiveStaff() || resource == null || (
        resource.data != null
        && 'status' in resource.data
        && resource.data.status == 'published'
        && 'publishedAt' in resource.data
        && resource.data.publishedAt != null
        && resource.data.publishedAt is timestamp
        && resource.data.publishedAt <= request.time
      );
      allow list: if isCurrentActiveStaff() || (
        resource != null
        && resource.data != null
        && 'status' in resource.data
        && resource.data.status == 'published'
        && 'publishedAt' in resource.data
        && resource.data.publishedAt != null
        && resource.data.publishedAt is timestamp
        && resource.data.publishedAt <= request.time
      );

      // Editors can create new draft articles
      allow create: if isEditor()
        && newsSlug == request.resource.data.slug
        && request.resource.data.status == 'draft'
        && request.resource.data.createdBy == request.auth.uid
        && isValidFeaturedImageStaging(request.resource.data);

      // Update rules with status-transition and role constraints
      allow update: if isCurrentActiveStaff()
        && request.resource.data.slug == resource.data.slug
        && (!('createdAt' in resource.data) || resource.data.createdAt == null || request.resource.data.createdAt == resource.data.createdAt)
        && (!('createdBy' in resource.data) || resource.data.createdBy == null || request.resource.data.createdBy == resource.data.createdBy)
        && request.resource.data.updatedBy == request.auth.uid
        && isValidFeaturedImageStaging(request.resource.data)
        && (
          // Published articles can ONLY be edited, unpublished, archived, or trashed by Content Admins
          (resource.data.status == 'published' && isContentAdmin())
          ||
          // Draft articles: Editors can update draft, submit for review, archive, or trash
          (resource.data.status == 'draft' && (
            (request.resource.data.status in ['draft', 'review', 'archived', 'trashed'] && isEditor())
            || (request.resource.data.status == 'published' && isContentAdmin())
          ))
          ||
          // Review articles: Editors can return to draft, keep in review, archive, or trash
          (resource.data.status == 'review' && (
            (request.resource.data.status in ['draft', 'review', 'archived', 'trashed'] && isEditor())
            || (request.resource.data.status == 'published' && isContentAdmin())
          ))
          ||
          // Unpublished articles: Content Admins can return to draft, republish, archive, or trash
          (resource.data.status == 'unpublished' && isContentAdmin() && (
            request.resource.data.status in ['draft', 'published', 'archived', 'unpublished', 'trashed']
          ))
          ||
          // Archived articles: Content Admins can return to draft or trash
          (resource.data.status == 'archived' && isContentAdmin() && (
            request.resource.data.status in ['draft', 'archived', 'trashed']
          ))
          ||
          // Trashed articles: Restore to draft allowed for Editors; restore to published requires Content Admin
          (resource.data.status == 'trashed' && (
            (request.resource.data.status in ['draft', 'trashed'] && isEditor())
            || (request.resource.data.status in ['draft', 'review', 'published', 'unpublished', 'archived'] && isContentAdmin())
          ))
        );

      // Permanent deletion strictly reserved for Super Admin on trashed items
      allow delete: if isSuperAdmin() && resource.data.status == 'trashed';
    }

    // Public read collections, restricted staff write
    match /news/{articleId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isContentAdmin();
    }

    // Collection: achievements (CMS Achievements)
    match /achievements/{achievementSlug} {
      // Public can read only published achievements where publishedAt <= request.time; active staff can read any status
      allow get: if isCurrentActiveStaff() || (
        resource.data.status == 'published'
        && resource.data.publishedAt != null
        && resource.data.publishedAt is timestamp
        && resource.data.publishedAt <= request.time
      );
      allow list: if isCurrentActiveStaff() || (
        resource.data.status == 'published'
        && resource.data.publishedAt != null
        && resource.data.publishedAt is timestamp
        && resource.data.publishedAt <= request.time
      );

      // Editors and Content Admins can create new draft achievements
      allow create: if isEditor()
        && achievementSlug == request.resource.data.slug
        && request.resource.data.status == 'draft'
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.version == 1
        && isValidFeaturedImageStaging(request.resource.data);

      // Update rules with status-transition and role constraints
      allow update: if isCurrentActiveStaff()
        && request.resource.data.slug == resource.data.slug
        && (!('createdAt' in resource.data) || resource.data.createdAt == null || request.resource.data.createdAt == resource.data.createdAt)
        && (!('createdByUid' in resource.data) || resource.data.createdByUid == null || request.resource.data.createdByUid == resource.data.createdByUid)
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.version == resource.data.version + 1
        && isValidFeaturedImageStaging(request.resource.data)
        && (
          // Published achievements can ONLY be edited, unpublished, archived, or trashed by Content Admins
          (resource.data.status == 'published' && isContentAdmin())
          ||
          // Draft achievements: Editors can update draft, submit for review, archive, or trash
          (resource.data.status == 'draft' && (
            (request.resource.data.status in ['draft', 'review', 'archived', 'trashed'] && isEditor())
            || (request.resource.data.status == 'published' && isContentAdmin())
          ))
          ||
          // Review achievements: Editors can return to draft, keep in review, archive, or trash
          (resource.data.status == 'review' && (
            (request.resource.data.status in ['draft', 'review', 'archived', 'trashed'] && isEditor())
            || (request.resource.data.status == 'published' && isContentAdmin())
          ))
          ||
          // Unpublished achievements: Content Admins can return to draft, republish, archive, or trash
          (resource.data.status == 'unpublished' && isContentAdmin() && (
            request.resource.data.status in ['draft', 'published', 'archived', 'unpublished', 'trashed']
          ))
          ||
          // Archived achievements: Content Admins can return to draft or trash
          (resource.data.status == 'archived' && isContentAdmin() && (
            request.resource.data.status in ['draft', 'archived', 'trashed']
          ))
          ||
          // Trashed achievements: Restore to draft allowed for Editors; restore to published requires Content Admin
          (resource.data.status == 'trashed' && (
            (request.resource.data.status in ['draft', 'trashed'] && isEditor())
            || (request.resource.data.status in ['draft', 'review', 'published', 'unpublished', 'archived'] && isContentAdmin())
          ))
        );

      // Permanent deletion is prohibited for browser clients. Must occur via trusted backend function.
      allow delete: if false;
    }

    // Collection: agriculturalAlerts (CMS Agricultural Alerts & Advisories)
    match /agriculturalAlerts/{alertSlug} {
      // Public can read only published alerts where effectiveFrom <= request.time AND (expiresAt is null or > request.time)
      // Active staff can read any alert document regardless of status
      allow get: if isCurrentActiveStaff() || resource == null || (
        resource != null
        && resource.data != null
        && 'status' in resource.data
        && resource.data.status == 'published'
        && 'effectiveFrom' in resource.data
        && resource.data.effectiveFrom != null
        && resource.data.effectiveFrom is timestamp
        && resource.data.effectiveFrom <= request.time
        && (!('expiresAt' in resource.data) || resource.data.expiresAt == null || (resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time))
      );
      allow list: if isCurrentActiveStaff() || (
        resource != null
        && resource.data != null
        && 'status' in resource.data
        && resource.data.status == 'published'
        && 'effectiveFrom' in resource.data
        && resource.data.effectiveFrom != null
        && resource.data.effectiveFrom is timestamp
        && resource.data.effectiveFrom <= request.time
        && (!('expiresAt' in resource.data) || resource.data.expiresAt == null || (resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time))
      );

      // Editors and Advisory Officers can create new draft alerts
      allow create: if (isEditor() || isAdvisoryOfficer())
        && alertSlug == request.resource.data.slug
        && request.resource.data.status == 'draft'
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.version == 1
        && isValidFeaturedImageStaging(request.resource.data);

      // Update rules with status-transition and role constraints
      allow update: if isCurrentActiveStaff()
        && request.resource.data.slug == resource.data.slug
        && (!('createdAt' in resource.data) || resource.data.createdAt == null || request.resource.data.createdAt == resource.data.createdAt)
        && (!('createdByUid' in resource.data) || resource.data.createdByUid == null || request.resource.data.createdByUid == resource.data.createdByUid)
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.version == resource.data.version + 1
        && isValidFeaturedImageStaging(request.resource.data)
        && (
          // Published alerts can ONLY be edited, unpublished, expired, archived, or trashed by Content Admins
          (resource.data.status == 'published' && isContentAdmin() && (
            request.resource.data.status in ['published', 'unpublished', 'expired', 'archived', 'trashed']
          ))
          ||
          // Draft alerts: Editors/Advisory Officers can update draft, submit for review, archive, or trash; Content Admin can publish
          (resource.data.status == 'draft' && (
            (request.resource.data.status in ['draft', 'review', 'archived', 'trashed'] && (isEditor() || isAdvisoryOfficer()))
            || (request.resource.data.status == 'published' && isContentAdmin())
          ))
          ||
          // Review alerts: Editors/Advisory Officers can return to draft, keep in review, archive, or trash; Content Admin can publish
          (resource.data.status == 'review' && (
            (request.resource.data.status in ['draft', 'review', 'archived', 'trashed'] && (isEditor() || isAdvisoryOfficer()))
            || (request.resource.data.status == 'published' && isContentAdmin())
          ))
          ||
          // Unpublished alerts: Content Admins can return to draft, republish, archive, or trash
          (resource.data.status == 'unpublished' && isContentAdmin() && (
            request.resource.data.status in ['draft', 'published', 'archived', 'unpublished', 'trashed']
          ))
          ||
          // Expired alerts: Content Admins can return to draft, archive, or trash
          (resource.data.status == 'expired' && isContentAdmin() && (
            request.resource.data.status in ['draft', 'archived', 'trashed', 'expired']
          ))
          ||
          // Archived alerts: Content Admins can return to draft or trash
          (resource.data.status == 'archived' && isContentAdmin() && (
            request.resource.data.status in ['draft', 'archived', 'trashed']
          ))
          ||
          // Trashed alerts: Restore to draft allowed for Editors/Advisory Officers; restore to published requires Content Admin
          (resource.data.status == 'trashed' && (
            (request.resource.data.status in ['draft', 'trashed'] && (isEditor() || isAdvisoryOfficer()))
            || (request.resource.data.status in ['draft', 'review', 'published', 'unpublished', 'expired', 'archived'] && isContentAdmin())
          ))
        );

      // Permanent deletion is prohibited for browser clients. Must occur via trusted backend endpoint.
      allow delete: if false;
    }

    match /alerts/{alertId} {
      allow read: if true;
      allow create, update, delete: if isAdvisoryOfficer();
    }

    // Recorded prices, one document per sighting.
    //
    // Public read is the point: a price list that requires an account helps
    // nobody who needs it.
    //
    // Append-only with one exception, the same shape as fleetFuelLogs. A price
    // recorded against the wrong market, or with the figure transposed, are the
    // two mistakes that actually happen at a desk, and both need undoing -- so
    // an existing observation may be marked superseded and nothing else. The
    // clause enforces that literally: the only fields a writer may touch on an
    // existing row are the three that record the correction.
    //
    // Editing the price in place would erase the fact that the public site
    // showed a different number, which somebody may have acted on. Deleting
    // would leave a gap in a series the trend arithmetic cannot explain.
    match /marketPrices/{priceId} {
      allow read: if true;
      allow create: if isMarketOfficer();
      allow update: if isMarketOfficer()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['supersededAt', 'supersededByUid', 'supersedeReason']);
      allow delete: if false;
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow create, update, delete: if isContentAdmin();
    }

    // Collection: mediaAssets (Authoritative Media Asset Metadata)
    // Only trusted backend code may create, update, or delete mediaAssets.
    // Active owners with media.upload role can read metadata of their own mediaAssets.
    // Active staff with media.manage role can read managed media records.
    match /mediaAssets/{mediaId} {
      // These two clauses used to test a `permissions` array on the staff
      // document. No code has ever written that field, so the clauses were
      // always false and only the ownerUid and isContentAdmin branches ever
      // matched. Expressed as roles: media.upload is held by editor and above,
      // media.manage by contentAdmin and above.
      allow get: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        isEditor()
      );
      allow list: if isSignedIn() && isContentAdmin();
      allow create, update, delete: if false;
    }

    // Audit logs: Read restricted to active staff with audit.view permission (superAdmin, contentAdmin).
    match /auditLogs/{logId} {
      allow read: if hasAuditViewPermission();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /newsAuditLogs/{logId} {
      allow read: if hasAuditViewPermission();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /adminAuditLogs/{logId} {
      // Read is deliberately wider than hasAuditViewPermission by exactly one
      // step: any active staff member may read a log entry, because appending
      // one requires reading it first. Signed-out and inactive users still see
      // nothing. The admin UI that browses the trail remains gated on
      // audit.view in application code.
      allow get: if canAppendAuditLog();
      allow list: if hasAuditViewPermission();
      allow create: if canAppendAuditLog();
      allow update, delete: if false;
    }

    // Helper function for canonical zone validation in security rules
    function isCanonicalZone(zoneId) {
      return zoneId in [
        'west_wellega', 'east_wellega', 'ilu_aba_bora', 'jimma',
        'west_shewa', 'north_shewa', 'east_shewa', 'arsi',
        'west_hararghe', 'east_hararghe', 'bale', 'borena',
        'south_west_shewa', 'guji', 'west_guji', 'buno_bedele',
        'west_arsi', 'kelem_wellega', 'horo_gudru_wellega',
        'shager_city', 'east_bale', 'east_borena'
      ];
    }

    // Collection: investmentZoneProfiles (Governed: reads allowed, direct client writes blocked)
    match /investmentZoneProfiles/{zoneId} {
      allow get, list: if isCurrentActiveStaff() || (
        resource != null && resource.data != null
        && resource.data.status == 'published'
        && resource.data.verificationStatus == 'verified'
      );
      allow create, update, delete: if false;
    }

    // Collection: investmentDatasets (Governed: reads allowed, direct client writes blocked)
    match /investmentDatasets/{datasetId} {
      allow get, list: if isCurrentActiveStaff() || (
        resource != null && resource.data != null
        && resource.data.lifecycleStatus == 'published'
        && resource.data.verificationStatus == 'verified'
      );
      allow create, update, delete: if false;

      // Subcollection: values/{zoneId}
      match /values/{zoneId} {
        allow get, list: if isCurrentActiveStaff() || (
          get(/databases/$(database)/documents/investmentDatasets/$(datasetId)).data != null
          && get(/databases/$(database)/documents/investmentDatasets/$(datasetId)).data.lifecycleStatus == 'published'
          && get(/databases/$(database)/documents/investmentDatasets/$(datasetId)).data.verificationStatus == 'verified'
        );
        allow create, update, delete: if false;
      }
    }

    // Collection: investmentSources (Governed: reads allowed, direct client writes blocked)
    match /investmentSources/{sourceId} {
      allow get, list: if isCurrentActiveStaff() || (
        resource != null && resource.data != null
        && (resource.data.status == 'active' || resource.data.status == 'published')
      );
      allow create, update, delete: if false;
    }

    // Collection: investmentMethodologies (Governed: reads allowed, direct client writes blocked)
    match /investmentMethodologies/{methodologyId} {
      allow get, list: if isCurrentActiveStaff() || (
        resource != null && resource.data != null
        && (resource.data.status == 'active' || resource.data.status == 'published')
      );
      allow create, update, delete: if false;
    }

    // Collection: investmentOpportunities (Governed: reads allowed, direct client writes blocked)
    match /investmentOpportunities/{opportunityId} {
      allow get, list: if isCurrentActiveStaff() || (
        resource != null && resource.data != null
        && resource.data.lifecycleStatus == 'published'
        && resource.data.verificationStatus == 'verified'
      );
      allow create, update, delete: if false;
    }

    // Collection: investmentInfrastructure (Governed: reads allowed, direct client writes blocked)
    match /investmentInfrastructure/{recordId} {
      allow get, list: if isCurrentActiveStaff() || (
        resource != null && resource.data != null
        && resource.data.lifecycleStatus == 'published'
        && resource.data.verificationStatus == 'verified'
      );
      allow create, update, delete: if false;
    }

    // Collection: investmentMapConfig (Governed: reads allowed, direct client writes blocked)
    match /investmentMapConfig/{configId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // Collection: investmentAuditLogs (Authoritative audit logs: reads allowed for audit staff, browser writes strictly denied)
    match /investmentAuditLogs/{logId} {
      allow read: if hasAuditViewPermission();
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------- FLEET
    // Vehicle and machinery register.
    //
    // Unlike news, alerts and investment content, NOTHING here is public. This
    // is an internal operational record: which machines the Bureau owns, where
    // they are and who holds them. There is no published state and no anonymous
    // read — every rule below requires active staff.

    // This block used to gate every fleet write on a `permissions` array stored
    // on the staff document. Nothing in the application has ever written that
    // field — not AuthContext, not the seed services, not StaffManagementPage,
    // which performs no writes at all — so the clause was false for every
    // document that will ever exist and every fleet write would have been
    // denied, including for a super admin.
    //
    // Reads were unaffected, which is what made it dangerous: the module would
    // have listed, rendered and then refused every button.
    //
    // Fleet now gates on the role string, like news, alerts and achievements
    // do, because `role` is a field every staff-provisioning path writes.
    // The mapping is not a simplification: in ROLE_PERMISSIONS_MAP every
    // fleet.* permission is held by exactly superAdmin and fleetOfficer, and
    // fleet.asset.retire by superAdmin alone.

    match /fleetAssets/{assetId} {
      allow get, list: if isCurrentActiveStaff();
      allow create: if isFleetOfficer();
      // Retiring is the one irreversible act here, and fleet.asset.retire is
      // granted to superAdmin alone. The rule enforces it the only way it can:
      // by refusing a write that sets the status to 'disposed'. Without this,
      // the permission existed in the table and was checked nowhere.
      allow update: if isSuperAdmin()
                    || (isFleetOfficer() && request.resource.data.status != 'disposed');
      // Assets are retired by setting status to 'disposed', never deleted: the
      // register's value is its history, and the audit trail points at these ids.
      allow delete: if false;
    }

    match /fleetAssignments/{assignmentId} {
      allow get, list: if isCurrentActiveStaff();
      allow create, update: if isFleetOfficer();
      // The sign-out book is append-only. A returned row is closed, not removed.
      allow delete: if false;
    }

    match /fleetWorkOrders/{workOrderId} {
      allow get, list: if isCurrentActiveStaff();
      allow create: if isCurrentActiveStaff();
      // Anyone may report a fault — the driver who finds it is rarely the
      // mechanic — but only the garage may move the job through its lifecycle.
      allow update: if isFleetOfficer();
      allow delete: if false;
    }

    // The per-machine timeline. Written by every status change, so without this
    // clause Firestore's default deny silently drops the history the moment a
    // real project is configured — invisible in demo mode, where nothing writes
    // to Firestore at all.
    match /fleetStatusEvents/{eventId} {
      allow get, list: if isCurrentActiveStaff();
      allow create: if isFleetOfficer();
      // A timeline is a record of what happened. Correcting it means adding to
      // it, never editing what it already says.
      allow update, delete: if false;
    }

    match /fleetServiceRecords/{recordId} {
      allow get, list: if isCurrentActiveStaff();
      allow create: if isFleetOfficer();
      // Append-only: a mistyped service reading stays visible in context rather
      // than becoming the truth.
      allow update, delete: if false;
    }

    // The people who drive and operate the machines.
    //
    // Records, not accounts. A zone operator has no portal login, so nothing
    // here can be tied back to request.auth — these documents describe people
    // who will never sign in. Reads are open to any active staff member because
    // the issue form has to name a driver; writing one is narrower.
    match /fleetDrivers/{driverId} {
      allow get, list: if isCurrentActiveStaff();
      allow create, update: if isFleetOfficer();
      // A driver who leaves is set inactive, never deleted: the sign-out book
      // points at these ids, and removing one would orphan its own history.
      allow delete: if false;
    }

    // Fuel slips, typed from paper at a pump.
    //
    // Append-only with one exception. A slip against the wrong vehicle, or with
    // the litres transposed, are the two mistakes that actually happen at a
    // counter, and both need undoing — so an existing row may be voided and
    // nothing else. The clause below enforces that literally: the only fields a
    // writer may touch on an existing slip are the three that record the void.
    match /fleetFuelLogs/{fuelLogId} {
      allow get, list: if isCurrentActiveStaff();
      allow create: if isFleetOfficer();
      allow update: if isFleetOfficer()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['voidedAt', 'voidedByUid', 'voidReason']);
      // Deleting would leave a gap the register cannot explain. A voided slip
      // stays visible, struck through, and out of every figure.
      allow delete: if false;
    }

    // fleetMeterReadings had a rule block here. It is gone, along with nothing
    // else: the collection has no name constant, no service, no query and no
    // writer — only a type and this block. A rule guarding something that does
    // not exist is a rule nobody maintains correctly, and it would have gone on
    // looking like the collection was in use. If meter history is built later,
    // the block comes back with the code that needs it.
  }
}
